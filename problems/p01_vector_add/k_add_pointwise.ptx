.version 8.0
.target sm_89
.address_size 64

.visible .entry k_add_pointwise(
    .param .u64 param_0,
    .param .u64 param_1,
    .param .u64 param_2
)
{
    .reg .b32 %r<14>;
    .reg .b64 %rd<13>;
    .reg .f32 %f<6>;
    .reg .pred %p<1>;

    ld.param.u64 %rd0, [param_0];
    cvta.to.global.u64 %rd0, %rd0;
    ld.param.u64 %rd1, [param_1];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [param_2];
    cvta.to.global.u64 %rd2, %rd2;
    // IR: Tile -- global thread id and bounds guard
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mad.lo.u32 %r3, %r1, %r2, %r0;
    setp.ge.u32 %p0, %r3, 512;
    @%p0 bra DONE;
    // IR: Load
    mul.lo.s32 %r4, %r3, 2;
    add.s32 %r5, %r4, 0;
    mul.wide.s32 %rd3, %r5, 4;
    add.u64 %rd4, %rd0, %rd3;
    ld.global.f32 %f0, [%rd4];
    // IR: Load
    mul.lo.s32 %r6, %r3, 2;
    add.s32 %r7, %r6, 0;
    mul.wide.s32 %rd5, %r7, 4;
    add.u64 %rd6, %rd1, %rd5;
    ld.global.f32 %f1, [%rd6];
    // IR: Assign
    add.rn.f32 %f2, %f0, %f1;
    // IR: Load
    mul.lo.s32 %r8, %r3, 2;
    add.s32 %r9, %r8, 1;
    mul.wide.s32 %rd7, %r9, 4;
    add.u64 %rd8, %rd0, %rd7;
    ld.global.f32 %f3, [%rd8];
    // IR: Load
    mul.lo.s32 %r10, %r3, 2;
    add.s32 %r11, %r10, 1;
    mul.wide.s32 %rd9, %r11, 4;
    add.u64 %rd10, %rd1, %rd9;
    ld.global.f32 %f4, [%rd10];
    // IR: Assign
    add.rn.f32 %f5, %f3, %f4;
    // IR: Write
    mul.lo.s32 %r12, %r3, 2;
    add.s32 %r13, %r12, 0;
    mul.wide.s32 %rd11, %r13, 4;
    add.u64 %rd12, %rd2, %rd11;
    st.global.v2.f32 [%rd12], {%f2, %f5};
DONE:
    ret;
}
